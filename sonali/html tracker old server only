async function markAttend(status){
    if (!S.empId) {
    toast('Please select employee first');
    return;
  }

  markChosenUI(status);
  document.getElementById('att-state').textContent = status + ' — saving...';
  document.getElementById('att-result').style.display = 'block';
  const syncId = 'att-sync-'+Date.now();
  document.getElementById('att-result').innerHTML =
    '<div class="lbox">Marking <strong>'+status+'</strong>...<br><span id="'+syncId+'">'+syncBadge('pending')+'</span></div>';
  toast('Marking attendance: '+status);

  try{
    const existing = await getDoc('Attendance',
      [['employee','=',S.empId],['attendance_date','=',todayISO()]],
      ['name']);

    let docName, result;
    const doc = {
      doctype              : 'Attendance',
      employee             : S.empId,
      attendance_date      : todayISO(),
      status               : ERP_STATUS[status] || 'Present',
      company              : S.company,
      custom_attendance_type: status
    };

    if(existing.length){
      result  = await updateDoc('Attendance', existing[0].name, doc);
      docName = existing[0].name;
    } else {
      result  = await saveDoc('Attendance', doc);
      docName = result.data ? result.data.name : '';
    }

    document.getElementById(syncId).innerHTML = syncBadge('ok', '/app/attendance/'+docName);
    document.getElementById('att-state').textContent = status + ' — marked at ' + fmtDT(now());
    toast('✅ Attendance saved: '+status);
  }catch(e){
    document.getElementById(syncId).innerHTML = syncBadge('err');
    document.getElementById('att-state').textContent = status + ' — save failed';
    console.error('Attendance ERPNext:', e);
    toast('❌ Attendance save failed');
  }
}

// ══════════════════════════════════════════════════════════
//  GPS
// ══════════════════════════════════════════════════════════
function getCoords(){
  return new Promise((res,rej)=>{
    if(!navigator.geolocation){rej(new Error('GPS not supported'));return;}
    navigator.geolocation.getCurrentPosition(res, err=>{
      const msgs=['','Location permission denied','GPS unavailable — check device settings','GPS timed out'];
      rej(new Error(msgs[err.code]||'GPS error'));
    },{enableHighAccuracy:true,timeout:12000,maximumAge:0});
  });
}

// ══════════════════════════════════════════════════════════
//  MAP (Leaflet)
// ══════════════════════════════════════════════════════════
let map = null;
let markersLayer = null;
let routeLine = null;

function initMap(lat,lon){
  if(map){map.remove();map=null;}
  map = L.map('map',{zoomControl:true,attributionControl:false}).setView([lat,lon],14);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);
  markersLayer = L.layerGroup().addTo(map);
  routeLine = null;
}

function makeMarker(lat,lon,color,size,title){
  const icon = L.divIcon({className:'',
    html:'<div style="background:'+color+';width:'+size+'px;height:'+size+'px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3)"></div>',
    iconSize:[size,size],iconAnchor:[size/2,size/2]});
  return L.marker([lat,lon],{icon}).bindPopup('<b>'+title+'</b><br>'+fmtCoords(lat,lon));
}

function fitMap(){
  if(!map) return;
  const bounds = [];
  if(S.startPoint) bounds.push([S.startPoint.lat, S.startPoint.lon]);
  if(S.stopPoint)  bounds.push([S.stopPoint.lat,  S.stopPoint.lon]);
  if(bounds.length > 1) map.fitBounds(L.latLngBounds(bounds),{padding:[32,32]});
  else if(bounds.length === 1) map.setView(bounds[0],15);
}

// ══════════════════════════════════════════════════════════
//  GOOGLE DIRECTIONS API — road route polyline
// ══════════════════════════════════════════════════════════

// Decode Google's encoded polyline format
function decodePolyline(encoded){
  const pts=[]; let idx=0,lat=0,lng=0;
  while(idx<encoded.length){
    let b,shift=0,result=0;
    do{b=encoded.charCodeAt(idx++)-63;result|=(b&0x1f)<<shift;shift+=5;}while(b>=0x20);
    lat+=(result&1)?~(result>>1):(result>>1);
    shift=0;result=0;
    do{b=encoded.charCodeAt(idx++)-63;result|=(b&0x1f)<<shift;shift+=5;}while(b>=0x20);
    lng+=(result&1)?~(result>>1):(result>>1);
    pts.push([lat/1e5,lng/1e5]);
  }
  return pts;
}

async function drawRoadRoute(lat1, lon1, lat2, lon2) {
  const res = await fetch(
    '/api/method/sonali.custom_functions.sales_track.get_route',
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Frappe-CSRF-Token': getCsrf()
      },
      credentials: 'same-origin',
      body: JSON.stringify({
        origin_lat: lat1,
        origin_lon: lon1,
        dest_lat: lat2,
        dest_lon: lon2
      })
    }
  );

  const j = await res.json();

  if (j.exc) {
    console.error("Route API error:", j);
    throw new Error("Route fetch failed");
  }

  const route = j.message;

  const decoded = polyline.decode(route.polyline);

  if (routeLine) {
    map.removeLayer(routeLine);
    routeLine = null;
  }

  routeLine = L.polyline(decoded, {
    color: '#2563eb',
    weight: 5,
    opacity: 0.8
  }).addTo(map);

  map.fitBounds(routeLine.getBounds(), {
    padding: [30, 30]
  });

  return {
    distance: route.distance_text,
    duration: route.duration_text,
    distance_km: route.distance_value / 1000,
    duration_minutes: Math.round(route.duration_value / 60)
  };
}
// ══════════════════════════════════════════════════════════
//  LOCATION TRACKING — only start & stop lat/lon stored
// ══════════════════════════════════════════════════════════
function setLocStatus(html){ document.getElementById('loc-status').innerHTML = html; }

async function startTracking(){
    if (!S.empId) {
    toast('Please select employee first');
    return;
  }

  if(S.tracking) return;
  setLocStatus('<span style="color:var(--cy)">⌛ Getting GPS fix...</span>');
  try{
    const p   = await getCoords();
    const lat = p.coords.latitude, lon = p.coords.longitude, t = now();
    S.tracking   = true;
    S.startPoint = {lat, lon, time: t};
    S.stopPoint  = null;

    // UI state
    document.getElementById('btn-loc-start').disabled = true;
    document.getElementById('btn-loc-start').classList.add('btn-gray');
    document.getElementById('btn-loc-stop').disabled = false;
    document.getElementById('btn-loc-stop').classList.remove('btn-gray');
    document.getElementById('loc-from').textContent = '✅';
    document.getElementById('loc-to').textContent   = '—';

    // Initialise map and place start marker
    initMap(lat, lon);
    makeMarker(lat, lon, '#16a34a', 20, 'Start — '+fmtDT(t)).addTo(markersLayer);
    setTimeout(()=>{ if(map) map.invalidateSize(); }, 250);

    setLocStatus(
      '<strong>Tracking active</strong> <span class="pulse" style="color:var(--cg)">●</span><br>'+
      '🟢 <b>Start:</b> '+fmtCoords(lat,lon)+
      '<br><small>'+fmtDT(t)+'</small>'+
      '<br><small style="color:var(--c1)">Tap Stop when you reach your destination</small>'
    );

    // Persist start point to ERPNext
    await saveLocationPoint('Start', lat, lon);

    toast('▶ Location tracking started');
  }catch(e){
    setLocStatus('<span style="color:var(--cr)">❌ '+e.message+'</span>');
    toast('GPS error: '+e.message);
  }
}

async function stopTracking(){
  if(!S.tracking) return;
  S.tracking = false;

  // Flip buttons immediately
  document.getElementById('btn-loc-start').disabled = false;
  document.getElementById('btn-loc-start').classList.remove('btn-gray');
  document.getElementById('btn-loc-stop').disabled = true;
  document.getElementById('btn-loc-stop').classList.add('btn-gray');

  setLocStatus('<span style="color:var(--cy)">⌛ Getting stop location...</span>');
  try{
    const p   = await getCoords();
    const lat = p.coords.latitude, lon = p.coords.longitude, t = now();
    S.stopPoint = {lat, lon, time: t};
    document.getElementById('loc-to').textContent = '✅';

    // Add stop marker
    makeMarker(lat, lon, '#dc2626', 20, 'Stop — '+fmtDT(t)).addTo(markersLayer);

    setLocStatus('<span style="color:var(--cy)">⌛ Drawing road route...</span>');

    // Draw road route via Directions API
    const from = S.startPoint;
    const road = await drawRoadRoute(from.lat, from.lon, lat, lon);

    fitMap();
    setTimeout(()=>{ if(map) map.invalidateSize(); }, 250);

    setLocStatus(
      '<strong>Session complete ■</strong><br>'+
      '🟢 <b>Start:</b> '+fmtCoords(from.lat,from.lon)+' · '+fmtDT(from.time)+'<br>'+
      '🔴 <b>Stop:</b> '+fmtCoords(lat,lon)+' · '+fmtDT(t)+'<br>'+
      '🛣️ <b>Distance:</b> '+road.distance+(road.duration!=='N/A'?' · '+road.duration:'')+
      (road.note?'<br><small style="color:var(--text2)">'+road.note+'</small>':'')
    );

    const log = {
      date: todayISO(),
    
      from_lat: from.lat,
      from_lon: from.lon,
    
      to_lat: lat,
      to_lon: lon,
    
      from_time: fmtDT(from.time),
      to_time: fmtDT(t),
    
      start_iso: from.time.toISOString().slice(0,19).replace('T',' '),
      stop_iso: t.toISOString().slice(0,19).replace('T',' '),
    
      distance: road.distance,
      duration: road.duration,
    
      distance_km: road.distance_km,
      duration_minutes: road.duration_minutes,
    
      note: road.note,
      employee: S.empId || S.employee || ''
    };
    S.locLogs.push(log);
    renderLocLog(log);

    toast('■ Stopped — '+road.distance);

    // Persist stop point and session log to ERPNext
    await saveLocationPoint('Stop', lat, lon);
    await saveTravelLog(log);
const ts = await createTimesheetDraft(log);

S.currentTimesheet = ts.name;

toast('Timesheet draft created');
    
  }catch(e){
    console.error('stopTracking:', e);
    toast('Stop error: '+e.message);
  }
}

