function selWT(btn, type){
  document.querySelectorAll('.wtype-btn').forEach(b=>b.classList.remove('sel'));
  btn.classList.add('sel'); S.workType = type;
}

const WT_ICONS = {
  Call:'📞', Meeting:'🤝', Visit:'🚗', 'Follow-up':'🔄',
  'Payment Collection':'💰', 'Sample Submission':'📦', 'Quotation Discussion':'📄'
};

async function submitTimesheet(){
    if (!S.empId) {
    toast('Please select employee first');
    return;
  }
  const date     = document.getElementById('ts-date').value;
  const customer = document.getElementById('ts-customer').value.trim();
  const remarks  = document.getElementById('ts-remarks').value.trim();
  const outcome  = document.getElementById('ts-outcome').value.trim();
  const followup = document.getElementById('ts-followup').value;

  if(!date)     { toast('⚠ Select a date'); return; }
  if(!customer) { toast('⚠ Enter customer name'); return; }
  if(!remarks)  { toast('⚠ Enter remarks'); return; }
  if(!outcome)  { toast('⚠ Enter outcome / next action'); return; }

  const entry = {date, emp:S.employee, customer, workType:S.workType, remarks, outcome, followup, at:now()};
  S.tsEntries.push(entry);

  // Render card immediately
  const el = document.getElementById('ts-log');
  if(el.querySelector('.empty')) el.innerHTML = '';
  const syncId = 'ts-sync-'+Date.now();
  const wt     = S.workType; // capture before reset
  const d = document.createElement('div'); d.className = 'ts-card';
  d.innerHTML =
    '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px">'+
      '<span class="ts-badge">'+(WT_ICONS[wt]||'📋')+' '+wt+'</span>'+
      '<span style="font-size:11px;color:var(--text2)">'+date+'</span>'+
    '</div>'+
    '<div style="font-size:14px;font-weight:700;color:var(--text);margin-bottom:4px">'+customer+'</div>'+
    '<div style="font-size:12px;color:#374151;line-height:1.8">'+
      '<b>Employee:</b> '+S.employee+'<br>'+
      '<b>Remarks:</b> '+remarks+'<br>'+
      '<b>Outcome:</b> '+outcome+
      (followup?'<br>📅 <b>Next follow-up:</b> '+followup:'')+
    '</div>'+
    '<div style="font-size:11px;color:var(--text2);margin-top:4px">Submitted '+fmtDT(entry.at)+'</div>'+
    '<div id="'+syncId+'">'+syncBadge('pending')+'</div>';
  el.insertBefore(d, el.firstChild);

  // Reset form
  document.getElementById('ts-customer').value = '';
  document.getElementById('ts-remarks').value  = '';
  document.getElementById('ts-outcome').value  = '';
  document.getElementById('ts-followup').value = '';
  document.querySelectorAll('.wtype-btn').forEach(b=>b.classList.remove('sel'));
  document.querySelector('.wtype-btn').classList.add('sel');
  S.workType = 'Call';
  toast('Submitting timesheet...');

  // → ERPNext Timesheet
  try {
  if (!S.currentTimesheet) {
    toast('Please complete location tracking first');
    document.getElementById(syncId).innerHTML = syncBadge('err');
    return;
  }

  const res = await fetch(
    '/api/method/sonali.custom_functions.sales_track.update_timesheet_details',
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Frappe-CSRF-Token': getCsrf()
      },
      credentials: 'same-origin',
      body: JSON.stringify({
        timesheet_name: S.currentTimesheet,
        customer_name: customer,
        work_type: wt,
        remarks: remarks,
        outcome: outcome,
        next_followup: followup || ''
      })
    }
  );

  const j = await res.json();

  if (j.exc) {
    throw new Error(j.exc);
  }

  document.getElementById(syncId).innerHTML =
    syncBadge('ok', '/app/timesheet/' + S.currentTimesheet);

  toast('✅ Timesheet updated');

} catch (e) {
  document.getElementById(syncId).innerHTML = syncBadge('err');
  console.error('Timesheet ERPNext:', e);
  toast('❌ Timesheet save failed');
}
}

